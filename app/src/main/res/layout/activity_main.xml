<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- ── Tag Preview ─────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAG PREVIEW  (5 cm × 2 cm)"
            android:textSize="11sp"
            android:textColor="#888888"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <com.osakaresearch.ezoprint.TagPreviewView
            android:id="@+id/previewView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp" />

        <!-- ── Device row ─────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Spinner
                android:id="@+id/spinnerDevices"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/spinner_bg"
                android:paddingStart="10dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnRefresh"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Refresh"
                android:textSize="13sp"
                android:backgroundTint="#607D8B"
                android:textColor="#FFF"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- ── Template selector ──────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TEMPLATE"
            android:textSize="11sp"
            android:textColor="#888"
            android:letterSpacing="0.08"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinnerTemplate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/spinner_bg"
            android:paddingStart="12dp"
            android:layout_marginBottom="14dp" />

        <!-- ── Input fields ────────────────────────────────────── -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLine1"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Product Name"
            android:layout_marginBottom="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLine1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLine2"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Price"
            android:layout_marginBottom="8dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLine2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilLine3"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="SKU / Barcode"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLine3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ── Logo row ────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnPickLogo"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Add Logo"
                android:textSize="13sp"
                android:backgroundTint="#5C6BC0"
                android:textColor="#FFF"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnClearLogo"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Clear"
                android:textSize="13sp"
                android:backgroundTint="#9E9E9E"
                android:textColor="#FFF" />
        </LinearLayout>

        <!-- ── Print / Feed buttons ────────────────────────────── -->
        <Button
            android:id="@+id/btnPrint"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="🖨  PRINT TAG"
            android:textSize="16sp"
            android:backgroundTint="#43A047"
            android:textColor="#FFF"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnFeed"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="↓  FEED PAPER"
            android:textSize="14sp"
            android:backgroundTint="#FF8F00"
            android:textColor="#FFF"
            android:layout_marginBottom="12dp" />

        <!-- ── Status ──────────────────────────────────────────── -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status: Ready"
            android:textSize="13sp"
            android:textColor="#444"
            android:padding="10dp"
            android:background="#E0E0E0" />

    </LinearLayout>
</ScrollView>
